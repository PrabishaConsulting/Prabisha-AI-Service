    <h2 class="text-xl font-bold text-slate-900 mt-10 mb-4">Quick Start Blueprint</h2>
    <div class="border border-indigo-100 rounded-xl p-4 mb-6 flex gap-4 items-start" style="background-color: rgba(17, 28, 168, 0.02);">
        <div class="p-2 rounded-lg bg-white shadow-sm text-indigo-700">
            <i class="fas fa-rocket"></i>
        </div>
            <p class="text-slate-600 text-sm leading-relaxed">
            <strong>Get started:</strong> Sign in to the <a href="/auth/central" class="font-semibold underline" style="color: #111CA8;">developer portal</a> and create an API key. Keep the secret on your server and send it in the <code>X-API-Key</code> header.
        </p>
    </div>

    <div class="space-y-6">
        <div>
            <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Target Gateway Base URL</label>
            <div class="bg-slate-900 rounded-lg p-3 text-sm font-mono text-emerald-400 border border-slate-800">
                https://aiservice.prabisha.com
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Required Auth Header</label>
            <div class="bg-slate-900 rounded-lg p-3 text-sm font-mono text-slate-300 border border-slate-800">
                <span class="text-purple-400">X-API-Key:</span> <span class="text-amber-400">your-secured-api-key-here</span>
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Initialize Script Pipeline</label>
                        <pre><code class="language-javascript">const response = await fetch('https://aiservice.prabisha.com/chat', {
    method: 'POST',
    headers: {
        'X-API-Key': process.env.AI_SERVICE_API_KEY,
        'Content-Type': 'application/json'
    },
    body: JSON.stringify({
        messages: [{ role: 'user', content: 'Hello, AI Gateway!' }],
        preferredProvider: 'GEMINI'
    })
});

const result = await response.json();
console.log(result.data.content);</code></pre>
        </div>
    </div>


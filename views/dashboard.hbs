<div class="space-y-8 max-w-7xl mx-auto pb-10">
    <!-- Header Section -->
    <div>
        <h2 class="text-3xl font-bold tracking-tight text-gray-900">Dashboard</h2>
        <p class="text-base text-gray-500 mt-1">Real-time statistics and activity for your system.</p>
    </div>

    <!-- Stats Overview Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Total Requests -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Total Requests</p>
                    <p class="text-3xl font-bold text-gray-900 mt-2">{{stats.totalCalls}}</p>
                    <span class="inline-flex items-center text-sm font-medium text-green-600 mt-2 gap-1.5">
                        <i class="fas fa-arrow-up text-xs"></i> +{{stats.growth}}% from last week
                    </span>
                </div>
                <div class="w-12 h-12 rounded-full flex items-center justify-center bg-blue-50 text-blue-600">
                    <i class="fas fa-chart-line text-lg"></i>
                </div>
            </div>
        </div>
        
        <!-- Active API Keys -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Active API Keys</p>
                    <p class="text-3xl font-bold text-gray-900 mt-2">{{stats.activeKeys}}</p>
                    <p class="text-sm text-gray-400 font-medium mt-2">{{stats.totalKeys}} total keys created</p>
                </div>
                <div class="w-12 h-12 rounded-full flex items-center justify-center bg-purple-50 text-purple-600">
                    <i class="fas fa-key text-lg"></i>
                </div>
            </div>
        </div>
        
        <!-- Connected Providers -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Active Providers</p>
                    <p class="text-3xl font-bold text-gray-900 mt-2">{{stats.activeProviders}}</p>
                    <p class="text-sm text-gray-400 font-medium mt-2">{{stats.totalProviders}} available</p>
                </div>
                <div class="w-12 h-12 rounded-full flex items-center justify-center bg-teal-50 text-teal-600">
                    <i class="fas fa-cloud text-lg"></i>
                </div>
            </div>
        </div>
        
        <!-- Total Cost -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Total Cost</p>
                    <p class="text-3xl font-bold text-gray-900 mt-2">${{formatNumber stats.totalCost}}</p>
                    <p class="text-sm font-medium text-orange-600 mt-2">This Month: ${{formatNumber stats.monthlyCost}}</p>
                </div>
                <div class="w-12 h-12 rounded-full flex items-center justify-center bg-orange-50 text-orange-500">
                    <i class="fas fa-dollar-sign text-lg"></i>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Traffic Chart -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm lg:col-span-2">
            <h3 class="text-lg font-semibold text-gray-900 mb-6">Traffic (Last 7 Days)</h3>
            <div class="h-64 relative w-full">
                <canvas id="usageChart"></canvas>
            </div>
        </div>
        
        <!-- Usage by Provider Chart -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-gray-900 mb-6">Usage by Provider</h3>
            <div class="h-64 relative w-full flex justify-center">
                <canvas id="providerChart"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Recent Activity Table -->
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
            <h3 class="text-lg font-semibold text-gray-900">Recent Requests</h3>
            <a href="/admin/analytics" class="text-sm font-medium text-blue-600 hover:text-blue-800 hover:underline">
                View All Activity &rarr;
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <th class="px-6 py-4">Time</th>
                        <th class="px-6 py-4">User</th>
                        <th class="px-6 py-4">Endpoint</th>
                        <th class="px-6 py-4">Provider</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Response Time</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    {{#each recentActivity}}
                    <tr class="hover:bg-gray-50 transition-colors group">
                        <td class="px-6 py-4 text-gray-500 font-mono text-xs">{{formatTime createdAt}}</td>
                        <td class="px-6 py-4 font-medium text-gray-900">{{user.email}}</td>
                        <td class="px-6 py-4 font-mono text-xs text-gray-500 bg-gray-50/50 group-hover:bg-transparent rounded">{{endpointPath}}</td>
                        <td class="px-6 py-4 text-gray-700">{{provider.name}}</td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wide bg-green-100 text-green-700">
                                {{status}}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-gray-900 font-mono text-xs">{{latencyMs}}ms</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Chart Defaults for better look
        Chart.defaults.font.family = "'Inter', 'Helvetica Neue', 'Helvetica', 'Arial', sans-serif";
        Chart.defaults.color = '#6b7280';

        // Traffic Chart
        const usageCtx = document.getElementById('usageChart').getContext('2d');
        new Chart(usageCtx, {
            type: 'line',
            data: {
                labels: {{{json usageLabels}}},
                datasets: [{
                    label: 'Requests',
                    data: {{{json usageData}}},
                    borderColor: '#3b82f6', // Tailwind blue-500
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 2.5,
                    tension: 0.3, // Smoother curves
                    fill: true,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#3b82f6',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(17, 24, 39, 0.9)',
                        padding: 12,
                        cornerRadius: 8,
                    }
                },
                scales: {
                    y: { 
                        beginAtZero: true,
                        grid: { color: '#f3f4f6', drawBorder: false }, 
                        ticks: { font: { size: 11 }, padding: 10 } 
                    },
                    x: { 
                        grid: { display: false, drawBorder: false }, 
                        ticks: { font: { size: 11 }, padding: 10 } 
                    }
                }
            }
        });
        
        // Provider Chart
        const providerCtx = document.getElementById('providerChart').getContext('2d');
        new Chart(providerCtx, {
            type: 'doughnut',
            data: {
                labels: {{{json providerLabels}}},
                datasets: [{
                    data: {{{json providerData}}},
                    backgroundColor: [
                        '#3b82f6', // blue-500
                        '#f97316', // orange-500
                        '#8b5cf6', // purple-500
                        '#14b8a6', // teal-500
                        '#64748b'  // slate-500
                    ],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { 
                        position: 'bottom', 
                        labels: { 
                            usePointStyle: true,
                            padding: 20,
                            font: { size: 12 } 
                        } 
                    },
                    tooltip: {
                        backgroundColor: 'rgba(17, 24, 39, 0.9)',
                        padding: 12,
                        cornerRadius: 8,
                    }
                },
                cutout: '75%'
            }
        });
    });
</script>
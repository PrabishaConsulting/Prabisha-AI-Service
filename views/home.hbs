<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Gateway | One API for AI workloads</title>
    <meta name="description" content="Use one authenticated API for chat, image generation, embeddings, and PDF document parsing.">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --ink: #111827;
            --paper: #f5f4ef;
            --blue: #111CA8;
            --orange: #DE6A2C;
            --line: #d9d9d2;
        }

        body {
            background: var(--paper);
            color: var(--ink);
            font-family: 'DM Sans', 'Segoe UI', sans-serif;
        }

        .hero-grid {
            background-image: linear-gradient(rgba(17, 28, 168, 0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(17, 28, 168, 0.045) 1px, transparent 1px);
            background-size: 36px 36px;
        }

        .terminal-top-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .rise-in {
            animation: rise-in 450ms ease-out both;
        }

        @keyframes rise-in {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @media (prefers-reduced-motion: reduce) {
            .rise-in { animation: none; }
        }
    </style>
</head>
<body class="antialiased selection:bg-orange-200">
    {{> public_header}}

    <main>
        <section class="hero-grid border-b border-gray-200 bg-white">
            <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 sm:py-20 lg:min-h-[650px] lg:grid-cols-[1fr_0.92fr] lg:gap-16 lg:px-10">
                <div class="rise-in">
                    <div class="mb-6 flex items-center gap-3">
                        <span class="h-2 w-2 rounded-full" style="background:#DE6A2C"></span>
                        <span class="text-xs font-bold uppercase tracking-wider text-gray-600">Production API · aiservice.prabisha.com</span>
                    </div>
                    <h1 class="max-w-3xl text-5xl font-bold leading-[1.04] text-gray-950 sm:text-6xl lg:text-7xl">
                        One API for<br>
                        <span style="color:#111CA8">AI workloads.</span>
                    </h1>
                    <p class="mt-7 max-w-xl text-lg leading-8 text-gray-600">
                        Connect your application to configured chat, image, embedding, and PDF parsing models through one authenticated gateway.
                    </p>
                    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
                        <a href="/auth/central" class="inline-flex items-center justify-center gap-2 rounded-md px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90" style="background:#111CA8">
                            Get an API key <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
                        </a>
                        <a href="/docs" class="inline-flex items-center justify-center gap-2 rounded-md border border-gray-300 bg-white px-5 py-3 text-sm font-semibold text-gray-800 transition hover:bg-gray-50">
                            Browse documentation
                        </a>
                    </div>
                    <div class="mt-9 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-500">
                        <span class="font-semibold text-gray-800">Base URL</span>
                        <code class="rounded border border-gray-200 bg-white px-2 py-1 text-xs text-gray-700">https://aiservice.prabisha.com</code>
                    </div>
                </div>

                <div class="rise-in overflow-hidden rounded-lg border border-gray-800 bg-gray-950 shadow-2xl" style="animation-delay:100ms">
                    <div class="flex items-center justify-between border-b border-gray-800 px-4 py-3">
                        <div class="flex items-center gap-1.5" aria-hidden="true">
                            <span class="terminal-top-dot" style="background:#ef786e"></span>
                            <span class="terminal-top-dot" style="background:#e4b94f"></span>
                            <span class="terminal-top-dot" style="background:#58b985"></span>
                        </div>
                        <span class="font-mono text-xs text-gray-400">POST /chat</span>
                        <span class="text-xs font-semibold text-emerald-400">200 OK</span>
                    </div>
                    <div class="overflow-x-auto p-5 sm:p-6">
                        <div class="mb-4 font-mono text-xs text-gray-500">Request</div>
                        <pre class="whitespace-pre-wrap break-words font-mono text-xs leading-6 text-gray-200 sm:text-sm"><span style="color:#83a5ff">fetch</span>(<span style="color:#f2b078">'https://aiservice.prabisha.com/chat'</span>, {
  method: <span style="color:#f2b078">'POST'</span>,
  headers: {
    <span style="color:#f2b078">'X-API-Key'</span>: process.env.AI_SERVICE_API_KEY,
    <span style="color:#f2b078">'Content-Type'</span>: <span style="color:#f2b078">'application/json'</span>
  },
  body: JSON.stringify({
    messages: [{ role: <span style="color:#f2b078">'user'</span>, content: <span style="color:#f2b078">'Hello, gateway'</span> }]
  })
});</pre>
                        <div class="my-5 border-t border-gray-800"></div>
                        <div class="mb-3 font-mono text-xs text-gray-500">Response</div>
                        <pre class="whitespace-pre-wrap break-words font-mono text-xs leading-6 text-emerald-300 sm:text-sm">{
  <span style="color:#83a5ff">"success"</span>: true,
  <span style="color:#83a5ff">"data"</span>: {
    <span style="color:#83a5ff">"content"</span>: <span style="color:#f2b078">"Hello! How can I help?"</span>,
    <span style="color:#83a5ff">"providerName"</span>: <span style="color:#f2b078">"GEMINI"</span>,
    <span style="color:#83a5ff">"usage"</span>: { <span style="color:#83a5ff">"totalTokens"</span>: 18 }
  }
}</pre>
                    </div>
                </div>
            </div>
        </section>

        <section class="border-b border-gray-200 bg-[#f5f4ef]">
            <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-y divide-gray-300 px-6 py-7 sm:grid-cols-4 sm:divide-y-0 lg:px-10">
                <div class="px-4 py-2 sm:px-6"><span class="block text-xl font-bold text-gray-950">Chat</span><span class="mt-1 block font-mono text-xs text-gray-500">POST /chat</span></div>
                <div class="px-4 py-2 sm:px-6"><span class="block text-xl font-bold text-gray-950">Images</span><span class="mt-1 block font-mono text-xs text-gray-500">POST /image</span></div>
                <div class="px-4 py-2 sm:px-6"><span class="block text-xl font-bold text-gray-950">Embeddings</span><span class="mt-1 block font-mono text-xs text-gray-500">POST /embeddings</span></div>
                <div class="px-4 py-2 sm:px-6"><span class="block text-xl font-bold text-gray-950">PDFs</span><span class="mt-1 block font-mono text-xs text-gray-500">POST /documents/parse</span></div>
            </div>
        </section>

        <section class="bg-white py-16 sm:py-20">
            <div class="mx-auto max-w-7xl px-6 lg:px-10">
                <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                    <div>
                        <p class="mb-3 text-xs font-bold uppercase tracking-wider" style="color:#DE6A2C">API surface</p>
                        <h2 class="text-3xl font-bold text-gray-950 sm:text-4xl">Start with the route you need.</h2>
                    </div>
                    <a href="/docs" class="text-sm font-semibold hover:underline" style="color:#111CA8">All documentation <i class="fas fa-arrow-right ml-1 text-xs" aria-hidden="true"></i></a>
                </div>

                <div class="divide-y divide-gray-200 border-y border-gray-200">
                    <a href="/docs/chat" class="group grid gap-3 py-5 sm:grid-cols-[170px_1fr_auto] sm:items-center">
                        <span class="font-mono text-xs font-semibold text-gray-500">POST /chat</span>
                        <span><strong class="text-gray-900">Chat completions</strong><span class="ml-3 text-sm text-gray-500">Send role/content messages and receive generated text.</span></span>
                        <i class="fas fa-arrow-right text-xs text-gray-400 transition group-hover:translate-x-1" aria-hidden="true"></i>
                    </a>
                    <a href="/docs/image" class="group grid gap-3 py-5 sm:grid-cols-[170px_1fr_auto] sm:items-center">
                        <span class="font-mono text-xs font-semibold text-gray-500">POST /image</span>
                        <span><strong class="text-gray-900">Image generation</strong><span class="ml-3 text-sm text-gray-500">Generate images using an active image model.</span></span>
                        <i class="fas fa-arrow-right text-xs text-gray-400 transition group-hover:translate-x-1" aria-hidden="true"></i>
                    </a>
                    <a href="/docs/embeddings" class="group grid gap-3 py-5 sm:grid-cols-[170px_1fr_auto] sm:items-center">
                        <span class="font-mono text-xs font-semibold text-gray-500">POST /embeddings</span>
                        <span><strong class="text-gray-900">Text embeddings</strong><span class="ml-3 text-sm text-gray-500">Create a vector for one string or a batch of strings.</span></span>
                        <i class="fas fa-arrow-right text-xs text-gray-400 transition group-hover:translate-x-1" aria-hidden="true"></i>
                    </a>
                    <a href="/docs/documents" class="group grid gap-3 py-5 sm:grid-cols-[170px_1fr_auto] sm:items-center">
                        <span class="font-mono text-xs font-semibold text-gray-500">POST /documents/parse</span>
                        <span><strong class="text-gray-900">PDF parsing</strong><span class="ml-3 text-sm text-gray-500">Upload a PDF as multipart form data for Gemini processing.</span></span>
                        <i class="fas fa-arrow-right text-xs text-gray-400 transition group-hover:translate-x-1" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </section>

        <section class="border-y border-gray-200 bg-[#f5f4ef] py-14">
            <div class="mx-auto flex max-w-7xl flex-col gap-7 px-6 lg:flex-row lg:items-center lg:justify-between lg:px-10">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-gray-500">Configured providers</p>
                    <h2 class="mt-2 text-2xl font-bold text-gray-950">Use the active models in your gateway.</h2>
                </div>
                <div class="flex flex-wrap gap-x-7 gap-y-4 text-sm font-semibold text-gray-700">
                    <span><i class="fas fa-circle mr-2 text-xs" style="color:#10a37f" aria-hidden="true"></i>OpenAI</span>
                    <span><i class="fas fa-circle mr-2 text-xs" style="color:#d97757" aria-hidden="true"></i>Anthropic</span>
                    <span><i class="fas fa-circle mr-2 text-xs" style="color:#4285f4" aria-hidden="true"></i>Gemini</span>
                    <span><i class="fas fa-circle mr-2 text-xs" style="color:#f2a73b" aria-hidden="true"></i>Mistral</span>
                </div>
            </div>
        </section>

        <section class="bg-gray-950 py-14 text-white sm:py-16">
            <div class="mx-auto flex max-w-7xl flex-col gap-6 px-6 sm:flex-row sm:items-center sm:justify-between lg:px-10">
                <div>
                    <h2 class="text-3xl font-bold">Ready to make your first request?</h2>
                    <p class="mt-2 text-sm text-gray-400">Create a key, keep it server-side, and follow the endpoint guides.</p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a href="/auth/central" class="rounded-md px-5 py-3 text-center text-sm font-semibold text-white" style="background:#DE6A2C">Get an API key</a>
                    <a href="/docs/authentication" class="rounded-md border border-gray-700 px-5 py-3 text-center text-sm font-semibold text-gray-200 hover:bg-gray-900">Authentication guide</a>
                </div>
            </div>
        </section>
    </main>

    <footer class="bg-gray-950 px-6 pb-8 text-xs text-gray-500">
        <div class="mx-auto flex max-w-7xl flex-col gap-2 border-t border-gray-800 pt-6 sm:flex-row sm:justify-between lg:px-4">
            <span>AI Gateway · <a class="hover:text-white" href="https://aiservice.prabisha.com">aiservice.prabisha.com</a></span>
            <span>API keys are required for all AI endpoints.</span>
        </div>
    </footer>
</body>
</html>

<div class="space-y-8 max-w-7xl mx-auto pb-10">
    <!-- Header Section -->
    <div>
        <h2 class="text-3xl font-bold tracking-tight text-gray-900">Analytics & Usage</h2>
        <p class="text-base text-gray-500 mt-1">Monitor API requests, token consumption, and provider costs.</p>
    </div>
    
    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Trend Chart -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow lg:col-span-2">
            <h3 class="text-lg font-semibold text-gray-900 mb-6">Requests (Last 30 Days)</h3>
            <div class="h-72 relative w-full">
                <canvas id="trendChart"></canvas>
            </div>
        </div>
        
        <!-- Distribution Chart -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-lg font-semibold text-gray-900 mb-6">Usage by Provider</h3>
            <div class="h-72 relative w-full flex justify-center">
                <canvas id="distChart"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Top Users Table -->
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
            <h3 class="text-lg font-semibold text-gray-900">Top Users by Token Usage</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <th class="px-6 py-4">User</th>
                        <th class="px-6 py-4">Total Requests</th>
                        <th class="px-6 py-4">Tokens Used</th>
                        <th class="px-6 py-4 text-right">Total Cost</th>
                    </tr>
                </thead>
                <tbody id="topUsersTable" class="divide-y divide-gray-100 text-gray-600">
                    <!-- Loading State -->
                    <tr>
                        <td colspan="4" class="px-6 py-8 text-center text-gray-400">
                            <i class="fas fa-circle-notch fa-spin text-2xl mb-2 block"></i>
                            <p class="text-sm">Loading usage data...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Chart Defaults for a clean, modern look
        Chart.defaults.font.family = "'Inter', 'Helvetica Neue', 'Helvetica', 'Arial', sans-serif";
        Chart.defaults.color = '#6b7280';
        
        fetch('/admin/api/analytics/stats')
            .then(res => res.json())
            .then(data => {
                // Render 30-Day Trend Chart
                const trendCtx = document.getElementById('trendChart').getContext('2d');
                new Chart(trendCtx, {
                    type: 'line',
                    data: {
                        labels: data.dailyLabels,
                        datasets: [{
                            label: 'Requests',
                            data: data.dailyCounts,
                            borderColor: '#f97316', // Tailwind orange-500
                            backgroundColor: 'rgba(249, 115, 22, 0.1)',
                            borderWidth: 2.5,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#f97316',
                            pointBorderWidth: 2,
                            pointRadius: 3,
                            pointHoverRadius: 6,
                            tension: 0.3, // Smoother curves
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { 
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: 'rgba(17, 24, 39, 0.9)',
                                padding: 12,
                                cornerRadius: 8,
                            }
                        },
                        scales: {
                            y: { 
                                beginAtZero: true,
                                grid: { color: '#f3f4f6', drawBorder: false }, 
                                ticks: { font: { size: 11 }, padding: 10 } 
                            },
                            x: { 
                                grid: { display: false, drawBorder: false }, 
                                ticks: { font: { size: 11 }, padding: 10, maxTicksLimit: 10 } 
                            }
                        }
                    }
                });
                
                // Render Provider Share Chart
                const distCtx = document.getElementById('distChart').getContext('2d');
                new Chart(distCtx, {
                    type: 'doughnut',
                    data: {
                        labels: data.providerLabels,
                        datasets: [{
                            data: data.providerCounts,
                            backgroundColor: [
                                '#3b82f6', // blue-500
                                '#f97316', // orange-500
                                '#8b5cf6', // purple-500
                                '#14b8a6', // teal-500
                                '#64748b'  // slate-500
                            ],
                            borderWidth: 0,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { 
                            legend: { 
                                position: 'bottom', 
                                labels: { 
                                    usePointStyle: true,
                                    padding: 20,
                                    font: { size: 12 } 
                                } 
                            },
                            tooltip: {
                                backgroundColor: 'rgba(17, 24, 39, 0.9)',
                                padding: 12,
                                cornerRadius: 8,
                            }
                        },
                        cutout: '75%'
                    }
                });
                
                // Render Top Users Table
                const tbody = document.getElementById('topUsersTable');
                tbody.innerHTML = ''; // Clear loading state
                
                if (data.topUsers && data.topUsers.length > 0) {
                    data.topUsers.forEach(user => {
                        tbody.innerHTML += `
                            <tr class="hover:bg-gray-50/80 transition-colors group">
                                <td class="px-6 py-4">
                                    <div class="font-medium text-gray-900">${user.email}</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 bg-gray-100 text-gray-700 rounded-lg text-xs font-semibold font-mono">
                                        ${Number(user.totalCalls).toLocaleString()}
                                    </span>
                                </td>
                                <td class="px-6 py-4 font-mono text-xs text-gray-500">
                                    ${Number(user.totalTokens).toLocaleString()}
                                </td>
                                <td class="px-6 py-4 text-right font-mono text-sm font-bold text-gray-900">
                                    $${Number(user.totalCost).toFixed(4)}
                                </td>
                            </tr>
                        `;
                    });
                } else {
                    // Empty State
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-gray-500">
                                <i class="fas fa-chart-bar text-gray-300 text-3xl mb-3 block"></i>
                                <p class="font-medium text-gray-900">No usage data found</p>
                                <p class="text-sm mt-1">Users haven't consumed any API resources yet.</p>
                            </td>
                        </tr>
                    `;
                }
            })
            .catch(err => {
                console.error('Failed to load analytics data:', err);
                const tbody = document.getElementById('topUsersTable');
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="px-6 py-8 text-center text-red-500">
                            <i class="fas fa-exclamation-circle mb-2 block text-xl"></i>
                            <p class="text-sm font-medium">Unable to load usage data. Please try refreshing the page.</p>
                        </td>
                    </tr>
                `;
            });
    });
</script>
<div class="space-y-8 max-w-7xl mx-auto pb-10">
    <!-- Header Section -->
    <div>
        <h2 class="text-3xl font-bold tracking-tight text-gray-900">Users</h2>
        <p class="text-base text-gray-500 mt-1">Manage user accounts, roles, and view their recent API activity.</p>
    </div>
    
    <!-- Users Table -->
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <th class="px-6 py-4">User</th>
                        <th class="px-6 py-4">Role</th>
                        <th class="px-6 py-4">API Keys</th>
                        <th class="px-6 py-4">Joined</th>
                        <th class="px-6 py-4 text-right">Activity</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    {{#each users}}
                    
                    <!-- Main User Row (Clickable) -->
                    <tr class="hover:bg-gray-50/80 transition-colors cursor-pointer group" onclick="toggleUserLogs('logs-{{@index}}', 'icon-{{@index}}')">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm text-blue-700 bg-blue-100 uppercase tracking-wider shrink-0">
                                    {{#if name}}{{name.charAt 0}}{{else}}{{email.charAt 0}}{{/if}}
                                </div>
                                <div>
                                    <div class="font-semibold text-gray-900">{{name}}</div>
                                    <div class="text-xs text-gray-500 mt-0.5">{{email}}</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-1 bg-gray-100 border border-gray-200 text-gray-700 rounded-full text-xs font-semibold uppercase tracking-wide">
                                {{role}}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-gray-700 font-medium">
                            {{apiKeys.length}}
                        </td>
                        <td class="px-6 py-4 text-gray-500 font-mono text-xs">
                            {{formatTime createdAt}}
                        </td>
                        <td class="px-6 py-4 text-right">
                            <button class="p-2 text-gray-400 group-hover:text-blue-600 transition-colors rounded-full hover:bg-blue-50 focus:outline-none">
                                <i id="icon-{{@index}}" class="fas fa-chevron-down transition-transform duration-200"></i>
                            </button>
                        </td>
                    </tr>
                    
                    <!-- Expandable Logs Row (Hidden by default) -->
                    <tr id="logs-{{@index}}" class="hidden bg-gray-50/40">
                        <td colspan="5" class="px-6 py-0 border-b border-gray-100">
                            <!-- Inner content wrapper for padding -->
                            <div class="py-5 overflow-hidden">
                                {{#if usageLogs.length}}
                                    <div class="flex items-center justify-between mb-3 px-1">
                                        <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Recent Activity Logs</h4>
                                        <span class="text-xs text-gray-400">{{usageLogs.length}} recent calls</span>
                                    </div>
                                    
                                    <!-- Inner Table/List for Logs -->
                                    <div class="bg-white border border-gray-200 rounded-xl max-h-64 overflow-y-auto shadow-sm">
                                        <ul class="divide-y divide-gray-100">
                                            {{#each usageLogs}}
                                            <li class="flex justify-between items-center py-2.5 px-4 hover:bg-gray-50 transition-colors">
                                                <span class="text-sm text-gray-700 flex items-center gap-3">
                                                    <span class="text-[10px] font-bold text-blue-700 bg-blue-50 border border-blue-200 px-1.5 py-0.5 rounded">POST</span>
                                                    <span class="font-mono text-xs">{{endpointPath}}</span>
                                                </span>
                                                <span class="text-xs text-gray-400 font-mono">{{formatTime createdAt}}</span>
                                            </li>
                                            {{/each}}
                                        </ul>
                                    </div>
                                {{else}}
                                    <!-- Empty State for Logs -->
                                    <div class="text-center py-8 text-gray-500 bg-white border border-dashed border-gray-200 rounded-xl">
                                        <i class="fas fa-history text-gray-300 text-3xl mb-3 block"></i>
                                        <p class="text-sm font-medium text-gray-900">No activity found</p>
                                        <p class="text-xs mt-1">This user hasn't made any API requests yet.</p>
                                    </div>
                                {{/if}}
                            </div>
                        </td>
                    </tr>
                    
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function toggleUserLogs(rowId, iconId) {
        const row = document.getElementById(rowId);
        const icon = document.getElementById(iconId);
        
        // Toggle the visibility of the logs row
        if (row.classList.contains('hidden')) {
            row.classList.remove('hidden');
            icon.classList.add('rotate-180');
        } else {
            row.classList.add('hidden');
            icon.classList.remove('rotate-180');
        }
    }
</script>